# CodeSentinel AI Environment Configuration
# Copy this file to .env and adjust variables as needed

ENVIRONMENT=development
DEBUG=true

# Database (Default: SQLite for instant local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./codesentinel.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesentinel

# Backend CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload and Archive Security Limits
MAX_UPLOAD_SIZE_BYTES=52428800     # 50 MB
MAX_EXTRACTED_SIZE_BYTES=209715200 # 200 MB
MAX_FILE_COUNT=2500
MAX_SINGLE_FILE_SIZE_BYTES=5242880 # 5 MB
MAX_DECOMPRESSION_RATIO=50.0       # Zip Bomb protection

# Static Analyzer Toggles & Subprocess Timeout
ANALYZER_TIMEOUT_SECONDS=60
RUFF_ENABLED=true
BANDIT_ENABLED=true
SEMGREP_ENABLED=true
PYTHON_AST_ENABLED=true
PATTERN_ENGINE_ENABLED=true
CROSS_FILE_ENABLED=true

# LLM Provider Configuration
# Supported providers: "demo" (fully offline, no key needed), "openai", "gemini", "custom"
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_CONTEXT_TOKENS=8000
